	pinctrl-names = "default", "idle", "sleep";
	pinctrl-0 = <&uart8_pins_mx>;
	pinctrl-1 = <&uart8_idle_pins_mx>;
	pinctrl-2 = <&uart8_sleep_pins_mx>;
	status = "okay";
	/delete-property/dmas;
	/delete-property/dma-names;
